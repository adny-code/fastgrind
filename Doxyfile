# Doxygen configuration for MERecorder
# Generated automatically.

PROJECT_NAME           = "MERecorder"
PROJECT_NUMBER         = 1.0
PROJECT_BRIEF          = "In-process memory allocation recorder and visualizer"

OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO

# Input
INPUT                  = include test README.md
FILE_PATTERNS          = *.h *.hpp *.c *.cpp *.md
RECURSIVE              = YES
EXCLUDE_SYMLINKS       = YES

# Build options
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
ALIASES                =

# Warnings
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        =

# Diagrams (Graphviz)
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
CLASS_DIAGRAMS         = YES
DOT_TRANSPARENT        = YES
DOT_MULTI_TARGETS      = YES

# HTML output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE_HUE    = 210
HTML_COLORSTYLE_SAT    = 110
HTML_COLORSTYLE_GAMMA  = 70
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
ENUM_VALUES_PER_LINE   = 1

# Disable unused formats
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_PERLMOD       = NO
GENERATE_PHPDOC        = NO
GENERATE_AUTOGEN_DEF   = NO
GENERATE_DOCSET        = NO
GENERATE_QHP           = NO
GENERATE_ECLIPSEHELP   = NO
GENERATE_TAGFILE       =

# Markdown
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md

# Performance
LOOKUP_CACHE_SIZE      = 8

# Misc
QUIET                  = NO
WARN_LOGFILE           =

